# =============================================================================
# .env.example — Environment variable reference for way2australia API
#
# Copy this file to .env and fill in real values for your local environment.
# The .env file is gitignored; this file is safe to commit (no real secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Runtime environment name. Controls behaviour like error verbosity.
# Values: development | staging | production
APP_ENV=development

# Enable debug mode. Should always be false in production.
# Values: true | false
APP_DEBUG=false

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------

# Host address the FastAPI server binds to.
# Use 0.0.0.0 to listen on all interfaces, or 127.0.0.1 for localhost only.
API_HOST=0.0.0.0

# TCP port the FastAPI server listens on.
API_PORT=8000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Minimum log level emitted by the application.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
