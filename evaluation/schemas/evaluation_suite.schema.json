{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_suite.schema.json",
  "title": "Way2Australia Evaluation Suite Manifest",
  "type": "object",
  "required": [
    "evaluation_suite_id",
    "version",
    "status",
    "introduced_in_release",
    "case_count",
    "datasets"
  ],
  "properties": {
    "evaluation_suite_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "replaced"
      ]
    },
    "introduced_in_release": {
      "type": "string",
      "minLength": 1
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "golden_answerable",
              "unanswerable_refusal",
              "security"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
