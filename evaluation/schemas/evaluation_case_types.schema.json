{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation_case_types.schema.json",
  "title": "Way2Australia Evaluation Case Types",
  "description": "Type-specific required fields built on evaluation_case.schema.json, plus the candidate row shape. Not a schema for a whole file: use one definition under $defs.",
  "$defs": {
    "golden_answerable": {
      "allOf": [
        {
          "$ref": "evaluation_case.schema.json"
        },
        {
          "required": [
            "query",
            "answerable",
            "relevant_document_ids",
            "query_language",
            "category"
          ],
          "properties": {
            "evaluation_suite_id": {
              "minLength": 1
            },
            "query": {
              "minLength": 1
            },
            "answerable": {
              "const": true
            },
            "relevant_document_ids": {
              "minItems": 1
            },
            "query_language": {
              "minLength": 1
            },
            "category": {
              "minLength": 1
            }
          }
        }
      ]
    },
    "unanswerable_refusal": {
      "allOf": [
        {
          "$ref": "evaluation_case.schema.json"
        },
        {
          "required": [
            "query",
            "answerable",
            "expected_behavior"
          ],
          "properties": {
            "evaluation_suite_id": {
              "minLength": 1
            },
            "query": {
              "minLength": 1
            },
            "answerable": {
              "const": false
            },
            "expected_behavior": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "security": {
      "allOf": [
        {
          "$ref": "evaluation_case.schema.json"
        },
        {
          "required": [
            "query",
            "attack_type",
            "expected_behavior"
          ],
          "properties": {
            "evaluation_suite_id": {
              "minLength": 1
            },
            "query": {
              "minLength": 1
            },
            "attack_type": {
              "type": "string",
              "minLength": 1
            },
            "expected_behavior": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "candidate_row": {
      "type": "object",
      "required": [
        "candidate_id",
        "status",
        "proposal_type",
        "target_suite_id",
        "proposed_by",
        "drafted_by",
        "requires_review",
        "needs_fluent_speaker_review",
        "rationale"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "suggested"
        },
        "proposal_type": {
          "type": "string",
          "enum": [
            "new_case",
            "case_change"
          ]
        },
        "target_suite_id": {
          "type": "string",
          "minLength": 1
        },
        "proposed_by": {
          "type": "string",
          "minLength": 1
        },
        "drafted_by": {
          "type": "string",
          "minLength": 1
        },
        "requires_review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needs_fluent_speaker_review": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "proposed_case": {
          "allOf": [
            {
              "$ref": "#/$defs/golden_answerable"
            },
            {
              "properties": {
                "status": {
                  "const": "suggested"
                }
              }
            }
          ]
        },
        "target_case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "array",
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proposal_type": {
                "const": "new_case"
              }
            },
            "required": [
              "proposal_type"
            ]
          },
          "then": {
            "required": [
              "proposed_case"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proposal_type": {
                "const": "case_change"
              }
            },
            "required": [
              "proposal_type"
            ]
          },
          "then": {
            "required": [
              "target_case_ids",
              "options"
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
